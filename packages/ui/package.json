{
    "name": "@bookplus/ui",
    "version": "0.1.0",
    "private": true,
    "description": "Shared Bookplus UI components (app-styled Select, DatePicker, TimePicker, confirm/alert dialogs), themed by @bookplus/design-tokens.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "prepare": "tsc -p tsconfig.json"
    },
    "peerDependencies": {
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "devDependencies": {
        "@bookplus/config": "workspace:*",
        "@types/react": "^18.2.0",
        "typescript": "^5.6.0"
    }
}
