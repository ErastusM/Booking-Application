{
    "name": "@bookplus/api-client",
    "version": "0.1.0",
    "private": true,
    "description": "Bookplus API client — one axios instance with the auth refresh interceptor, plus per-domain service methods. Shared by all apps.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "prepare": "tsc -p tsconfig.json"
    },
    "peerDependencies": {
        "axios": "^1.3.0"
    },
    "devDependencies": {
        "@bookplus/config": "workspace:*",
        "axios": "^1.3.0",
        "typescript": "^5.6.0"
    }
}
