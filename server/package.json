{
    "name": "bookplus-server",
    "version": "1.0.0-rc.8",
    "description": "Backend API for Bookplus multi-service booking application",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "jest --runInBand --forceExit",
        "e2e:server": "node e2e-server.js"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/tests/**/*.test.js"
        ],
        "testTimeout": 30000,
        "setupFiles": [
            "./src/tests/helpers/jestSetup.js"
        ],
        "coverageDirectory": "coverage",
        "collectCoverageFrom": [
            "src/controllers/**/*.js",
            "src/middleware/**/*.js",
            "src/utils/**/*.js"
        ]
    },
    "keywords": [
        "bookplus",
        "booking",
        "api"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.0.3",
        "express": "^4.18.2",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^8.5.2",
        "express-validator": "^7.0.0",
        "helmet": "^7.0.0",
        "jsonwebtoken": "^9.0.0",
        "mongoose": "^7.0.0",
        "node-cron": "^4.2.1",
        "nodemailer": "^8.0.7",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "@jest/globals": "^30.4.1",
        "jest": "^29.5.0",
        "mongodb-memory-server": "^11.2.0",
        "nodemon": "^2.0.22",
        "supertest": "^7.2.2"
    }
}
