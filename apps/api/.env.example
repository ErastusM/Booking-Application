# API dev port — 5050 locally (3000/3001/5000 are taken by other stacks; see CLAUDE.md)
PORT=5050
MONGODB_URI=mongodb://localhost:27017/bookplus
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
NODE_ENV=development
# pino log level: fatal|error|warn|info|debug|trace (default: info)
LOG_LEVEL=info
# Short-lived access token — the client silently refreshes it, so keep this small.
JWT_EXPIRE=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_this
REFRESH_TOKEN_EXPIRE=30d

# SMTP email (defaults to Hostinger). Leave EMAIL_USER/EMAIL_PASS unset to disable email.
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USER=info@bookplus.pro
EMAIL_PASS=your_mailbox_password
EMAIL_FROM_NAME=Bookplus
# Resend HTTP API key (resend.com) — when set, all mail goes via the HTTP API and
# SMTP above is bypassed entirely (useful where SMTP ports are blocked). Leave empty to use SMTP.
EMAIL_API_KEY=
# Inbox that receives suggestion-box submissions (default: info@bookplus.pro)
SUGGESTIONS_EMAIL=info@bookplus.pro

# Google OAuth — create credentials at console.cloud.google.com
# APIs & Services → Credentials → OAuth 2.0 Client ID (Web application)
# Redirect URI: http://localhost:5050/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# App URLs — CLIENT_URL doubles as the CORS allowlist and may be a comma-separated
# list of origins; the FIRST entry is the canonical customer origin used for OAuth
# redirects and emailed links. Local dev: customer app :3002, business app :3003.
CLIENT_URL=http://localhost:3002,http://localhost:3003
SERVER_URL=http://localhost:5050
# Canonical customer origin for redirects/emailed links. Defaults to the first
# CLIENT_URL entry — only set this to override.
#PUBLIC_ORIGIN=http://localhost:3002
# Business app origin — auth redirects for provider/staff/admin accounts return here.
# Defaults to the `business.*` entry in CLIENT_URL, else the customer origin; localhost
# has no `business.*` hostname, so set it explicitly in dev.
BUSINESS_ORIGIN=http://localhost:3003
# Domain attribute on the SSO refresh cookie so it spans subdomains
# (production sets .bookplus.pro). LEAVE UNSET for localhost dev.
#COOKIE_DOMAIN=.bookplus.pro

# Error alerting (optional) — webhook receiving Slack/Discord/Mattermost-style
# `{ text }` POSTs on server errors/crashes. No-op when empty; throttled to 5 per 5 min.
ALERT_WEBHOOK_URL=

# Initial admin account (seeded on first boot; skipped if either is unset)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Admin
ADMIN_PHONE=+264000000000

# Web Push (optional) — generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave blank to keep push notifications disabled (safe default; nothing is sent).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com
