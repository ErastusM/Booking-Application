# API origin only — the api-client appends /api itself.
VITE_API_URL=http://localhost:5050
# Customer marketplace origin — cross-app links (back to the customer site, customer-account redirects) point here.
VITE_CUSTOMER_URL=http://localhost:3002
# Google Maps JavaScript API key for the business-location MapPicker.
# Optional in dev — the map picker is unavailable without it.
VITE_GOOGLE_MAPS_API_KEY=
