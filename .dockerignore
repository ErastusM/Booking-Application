# Root .dockerignore for images built from the repo-root context (client).
# apps/api builds from its own context (./apps/api) with its own .dockerignore.
**/node_modules
**/build
**/dist
**/coverage
# Capacitor native projects — generated + gitignored; never belong in the web image.
**/android
**/ios
**/.env
**/.env.*
!**/.env.example
apps/api/
certbot/
nginx/
.git/
.github/
client/test-results/
client/e2e/
