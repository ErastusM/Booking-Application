# =============================================================================
# Production environment variables — copy to .env.production (never commit that)
# =============================================================================

# --- Docker MongoDB auth (used by docker-compose.yml) ---
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=CHANGE_ME_STRONG_PASSWORD

# --- Server ---
PORT=5000
NODE_ENV=production
LOG_LEVEL=info

# --- MongoDB ---
MONGODB_URI=mongodb://${MONGO_ROOT_USER}:${MONGO_ROOT_PASS}@mongodb:27017/bookplus?authSource=admin

# --- JWT ---
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
REFRESH_TOKEN_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING_DIFFERENT
JWT_EXPIRE=7d
REFRESH_TOKEN_EXPIRE=30d

# --- URLs ---
# CLIENT_URL doubles as the CORS allowlist — comma-separated origins. The FIRST
# entry is the canonical customer origin used for OAuth redirects and emailed
# links; the deploy workflow appends the business origin if it is missing.
CLIENT_URL=https://www.yourdomain.com,https://business.yourdomain.com
SERVER_URL=https://api.yourdomain.com
# Canonical customer origin — defaults to the first CLIENT_URL entry; set only to override.
#PUBLIC_ORIGIN=https://www.yourdomain.com
# Business app origin — auth redirects for provider/staff/admin accounts return here.
# Defaults to the `business.*` entry in CLIENT_URL, so usually not needed in production.
#BUSINESS_ORIGIN=https://business.yourdomain.com
# Domain attribute on the refresh cookie so it is sent to every subdomain.
# Sessions stay scoped per side (accountType) — the cookie never signs a
# customer into the business app or vice versa. The deploy workflow appends
# .bookplus.pro if missing.
COOKIE_DOMAIN=.yourdomain.com

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Email ---
# RECOMMENDED if the host blocks SMTP ports (465/587): Resend HTTP API over 443.
# Sign up at resend.com, verify the bookplus.pro domain, create an API key.
# When EMAIL_API_KEY is set it is used and SMTP is bypassed entirely.
EMAIL_API_KEY=
EMAIL_FROM_NAME=Bookplus
EMAIL_USER=info@bookplus.pro
# SMTP fallback (only used when EMAIL_API_KEY is empty). Many VPS hosts block these ports.
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_PASS=your_hostinger_mailbox_password
# Inbox that receives suggestion-box submissions (default: info@bookplus.pro)
SUGGESTIONS_EMAIL=info@bookplus.pro

# --- Error alerting (optional) ---
# Webhook receiving Slack/Discord/Mattermost-style `{ text }` POSTs on server
# errors/crashes. No-op when empty; throttled to 5 alerts per 5 minutes.
ALERT_WEBHOOK_URL=

# Online booking payments — PayGate PayHost (all OFF until PAYMENTS_ENABLED=true;
# the business app's FEATURES.paymentsEnabled in packages/config/features.mjs
# must be switched on with it). Never commit real credentials.
PAYMENTS_ENABLED=
# PayGate ID and PayHost password (the password is also the checksum key).
PAYGATE_ID=
PAYGATE_PASSWORD=
# PayHost SOAP endpoint (default https://secure.paygate.co.za/payhost/process.trans).
#PAYGATE_ENDPOINT=
# Public base URL PayGate posts back to (notify + return). Defaults to SERVER_URL.
#PAYGATE_CALLBACK_BASE_URL=
# Customer app origin for the payment result page. Defaults to PUBLIC_ORIGIN /
# the first CLIENT_URL entry.
#CUSTOMER_APP_URL=
# Minutes a booking's slot is held while the client pays (default 15, 5–120).
#PAYMENT_HOLD_MINUTES=15
# Bookplus commission on online payments, in basis points (100 = 1%; default 0).
#PLATFORM_COMMISSION_BPS=0

# --- Initial admin account (seeded on first boot; skipped if unset) ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_NAME=Admin
ADMIN_PHONE=+264000000000

# --- Web Push (optional) — generate: node -e "console.log(require('web-push').generateVAPIDKeys())" ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@yourdomain.com

# --- Backups (the `backup` compose service — nightly mongodump, ops/backup/) ---
# All optional; without the S3_* vars backups stay LOCAL-ONLY (./backups on the
# host), so a disk failure loses them. Uncomment and fill in for offsite copies.
# Hour of day (UTC, 2 digits) the daily backup runs (default: 03).
#BACKUP_HOUR=03
# Days of local archives to keep before rotation deletes them (default: 14).
#BACKUP_RETENTION_DAYS=14
# S3-compatible offsite target (DO Spaces, Backblaze B2, Cloudflare R2, AWS S3).
# Uploads happen only when BUCKET + both keys are set. S3_ENDPOINT is only
# needed for non-AWS providers (e.g. https://fra1.digitaloceanspaces.com).
#S3_ENDPOINT=https://your-region.digitaloceanspaces.com
#S3_BUCKET=your-backup-bucket
#S3_ACCESS_KEY=CHANGE_ME
#S3_SECRET_KEY=CHANGE_ME
