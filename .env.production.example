# =============================================================================
# Production environment variables — copy to .env.production (never commit that)
# =============================================================================

# --- Docker MongoDB auth (used by docker-compose.yml) ---
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=CHANGE_ME_STRONG_PASSWORD

# --- Server ---
PORT=5000
NODE_ENV=production
LOG_LEVEL=info

# --- MongoDB ---
MONGODB_URI=mongodb://${MONGO_ROOT_USER}:${MONGO_ROOT_PASS}@mongodb:27017/bookplus?authSource=admin

# --- JWT ---
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
REFRESH_TOKEN_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING_DIFFERENT
JWT_EXPIRE=7d
REFRESH_TOKEN_EXPIRE=30d

# --- URLs ---
CLIENT_URL=https://yourdomain.com
SERVER_URL=https://api.yourdomain.com

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Email (Gmail App Password) ---
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password_here

# --- Stripe (use sk_live_* for production) ---
STRIPE_SECRET_KEY=sk_live_CHANGE_ME

# --- React client ---
REACT_APP_API_URL=https://api.yourdomain.com
